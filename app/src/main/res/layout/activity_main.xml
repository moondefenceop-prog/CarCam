<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 번호판 감지 위치 하이라이트 오버레이 -->
    <com.carcam.platecheck.ui.PlateOverlayView
        android:id="@+id/plateOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 최근 인식 목록 (상단 우측) -->
    <LinearLayout
        android:id="@+id/recentListContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="12dp"
        android:padding="8dp"
        android:background="@color/overlay_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="최근 인식"
            android:textColor="#AAAAAA"
            android:textSize="11sp"
            android:layout_marginBottom="4dp" />

        <TextView android:id="@+id/tvRecent1"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/white" android:textSize="13sp"
            android:fontFamily="monospace" android:visibility="gone" />
        <TextView android:id="@+id/tvRecent2"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/white" android:textSize="13sp"
            android:fontFamily="monospace" android:visibility="gone" />
        <TextView android:id="@+id/tvRecent3"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/white" android:textSize="13sp"
            android:fontFamily="monospace" android:visibility="gone" />
        <TextView android:id="@+id/tvRecent4"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/white" android:textSize="13sp"
            android:fontFamily="monospace" android:visibility="gone" />
        <TextView android:id="@+id/tvRecent5"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/white" android:textSize="13sp"
            android:fontFamily="monospace" android:visibility="gone" />
    </LinearLayout>

    <!-- 인식이 안 될 때의 탈출구. 카메라 화면에서 바로 닿아야 하므로 목록 버튼과 나란히 둔다. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnManualCheck"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="12dp"
        android:text="@string/manual_check"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnPlateList"
        app:layout_constraintHorizontal_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPlateList"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:text="차량 목록"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnManualCheck"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1" />

    <!-- 모드 전환. 입출차 모드에서만 기록이 쌓이므로 상태가 항상 보여야 한다. -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/modeGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="12dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:layout_constraintBottom_toTopOf="@id/btnManualCheck"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipCheck"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mode_check"
            android:checked="true" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipParking"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mode_parking" />
    </com.google.android.material.chip.ChipGroup>

    <!-- 검증 캡처: 켜면 인식된 프레임을 들고 있다가 정정 입력과 함께 저장한다. -->
    <com.google.android.material.chip.Chip
        android:id="@+id/chipCapture"
        style="@style/Widget.MaterialComponents.Chip.Filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/verify_capture"
        app:layout_constraintBottom_toBottomOf="@id/modeGroup"
        app:layout_constraintTop_toTopOf="@id/modeGroup"
        app:layout_constraintStart_toEndOf="@id/modeGroup" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnReportWrong"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:text="@string/report_wrong"
        android:textSize="13sp"
        android:visibility="gone"
        app:backgroundTint="@color/not_registered_red"
        app:layout_constraintBottom_toTopOf="@id/modeGroup"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 입출차 모드 전용: 현재 주차 중 대수 + 기록 화면 진입 -->
    <TextView
        android:id="@+id/tvParkedCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/overlay_bg"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/btnPlateList"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvScanning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="자동 번호판 인식 중..."
        android:textColor="@color/white"
        android:textSize="13sp"
        android:background="@color/overlay_bg"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="12dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
